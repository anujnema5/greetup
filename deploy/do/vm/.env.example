# greetup-rtc droplet (~/greetup/.env)
# Copy to the VM: scp deploy/do/vm/.env.example root@<DROPLET_IP>:~/greetup/.env

# Droplet public IPv4 — required for WebRTC (clients reach this address)
VM_PUBLIC_IP=

# Image from DigitalOcean Container Registry (built on laptop/CI, pulled on VM)
RTC_IMAGE=registry.digitalocean.com/greetup/rtc-service:latest

# Redis runs on this same droplet (bind 0.0.0.0 — App Platform connects via VPC private IP)
REDIS_PASSWORD=

# Must match server + matching-service (App Platform env)
INTERNAL_API_KEY=

# Must match server (App Platform env)
RTC_JWT_SECRET=
