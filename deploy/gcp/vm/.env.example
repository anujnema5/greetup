# GCE VM public IP (required for WebRTC — clients must reach this address)
VM_PUBLIC_IP=

# rtc-service image from Artifact Registry
RTC_IMAGE=asia-south1-docker.pkg.dev/greetup-production-498717/greetup/rtc-service:latest

# Upstash Redis (production)
REDIS_URL=rediss://default:TOKEN@xxxx.upstash.io:6379

INTERNAL_API_KEY=
RTC_JWT_SECRET=
