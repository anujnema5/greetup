{
  "name": "greetup",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@greetup/server' --filter '@greetup/client' --filter '@greetup/matching-service' --filter '@greetup/rtc-service' --elide-lines=0 --if-present dev",
    "kill:ports": "powershell -ExecutionPolicy Bypass -File scripts/kill-dev-ports.ps1",
    "dev:fresh": "bun run kill:ports && bun run dev",
    "dev:all": "bun run --filter '@greetup/*' --elide-lines=0 --if-present dev",
    "build": "bun run --filter '@greetup/*' --if-present build",
    "typecheck": "bun run --filter '@greetup/*' --if-present typecheck",
    "test": "bun run --filter '@greetup/*' --if-present test",
    "lint": "bun run --filter '@greetup/client' lint"
  },
  "trustedDependencies": [
    "@firebase/util",
    "core-js",
    "esbuild",
    "mediasoup",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "unrs-resolver"
  ]
}
