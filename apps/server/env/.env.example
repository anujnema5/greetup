PORT=
# Bun bind address: dev default localhost; prod default 0.0.0.0. Use 0.0.0.0 in dev if you need LAN access.
# LISTEN_HOST=
DATABASE_URL=
BETTER_AUTH_URL=
WEB_CLIENT_HOST=
BETTER_AUTH_SECRET=
# Mailjet (https://app.mailjet.com/account/apikeys) — use Primary API key + Secret key
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Must be a verified sender address in Mailjet for your domain
MAIL_FROM_EMAIL=
# Optional display name (default: Greetup)
# MAIL_FROM_NAME=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
# Docker dev (docker-compose.dev.yml): host port 26379 → container 6379
REDIS_URL=redis://127.0.0.1:26379
# Fail Redis commands after this many ms (avoids Cloudflare 504 hangs). 0 = disable.
# REDIS_COMMAND_TIMEOUT_MS=3000
# REDIS_CONNECT_TIMEOUT_MS=10000
# MATCH_ENGINE_TIMEOUT_MS=8000
SERVER_URL=
# Parent domain for cross-subdomain auth cookies (e.g. greetup.club)
# AUTH_COOKIE_DOMAIN=
DEV_NOTIFICATION_EMAIL=
INTERNAL_API_KEY=
MATCH_ENGINE_URL=

# rtc-service base URL (HTTP + Socket.IO signalling). Local dev default matches code: http://localhost:5370
# RTC_SERVICE_URL=

# Shared with rtc-service — HS256 JWT for Socket.IO auth (min 16 chars; use 32+ in prod)
RTC_JWT_SECRET=
LISTEN_HOST=

# DigitalOcean Spaces (S3-compatible) — profile photos: POST /api/profile/photos/presign
# Endpoint format: https://REGION.digitaloceanspaces.com (e.g. nyc3, sfo3, fra1)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
DO_SPACES_ENDPOINT=
# Optional: object key prefix in bucket (default profile-images)
# DO_SPACES_KEY_PREFIX=profile-images
# Optional: CDN or custom domain base URL for public object URLs
# DO_SPACES_PUBLIC_BASE_URL=

# local = disk uploads (dev workaround when Spaces is unpaid/unavailable)
# spaces = DigitalOcean Spaces. Unset: local outside production, Spaces in production.
# OBJECT_STORAGE_DRIVER=local

MESSAGE_ENCRYPTION_KEY=
GEMINI_API_KEY=

# AWS SNS — phone OTP SMS delivery (replaces Firebase Phone Auth).
# IAM principal needs sns:Publish (+ sns:CheckIfPhoneNumberIsOptedOut for opt-out checks).
# New accounts start in the SNS SMS sandbox: SMS is delivered only to *verified* destination
# numbers until you request production access. Set a MonthlySpendLimit + billing alarm.
AWS_SNS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional alphanumeric Sender ID (unsupported in US/CA — those need a 10DLC/toll-free number).
# AWS_SNS_SENDER_ID=Greetup

# Phone OTP tunables (optional; defaults shown).
# OTP_TTL_SEC=300
# OTP_LENGTH=6
# OTP_MAX_ATTEMPTS=5