PORT=4000

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL (must have pgvector extension enabled)
DATABASE_URL=postgresql://user:password@localhost:5432/voiceiq

# Redis (shared with other services or dedicated)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# HMAC secret for signing webhook payloads
WEBHOOK_SECRET=change-me-in-production

# BullMQ worker concurrency
SCORING_CONCURRENCY=10
WEBHOOK_CONCURRENCY=5
