    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.10",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.18.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "@types/bun": "^1.3.11",
