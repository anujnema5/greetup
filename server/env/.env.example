PORT=
# Bun bind address: dev default localhost; prod default 0.0.0.0. Use 0.0.0.0 in dev if you need LAN access.
# LISTEN_HOST=
DATABASE_URL=
BETTER_AUTH_URL=
WEB_CLIENT_HOST=
BETTER_AUTH_SECRET=
# Mailjet (https://app.mailjet.com/account/apikeys) — use Primary API key + Secret key
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Must be a verified sender address in Mailjet for your domain
MAIL_FROM_EMAIL=
# Optional display name (default: Greetup)
# MAIL_FROM_NAME=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
# Docker dev (docker-compose.dev.yml): host port 26379 → container 6379
REDIS_URL=redis://127.0.0.1:26379
SERVER_URL=
# Parent domain for cross-subdomain auth cookies (e.g. greetup.club)
# AUTH_COOKIE_DOMAIN=
DEV_NOTIFICATION_EMAIL=
INTERNAL_API_KEY=
MATCH_ENGINE_URL=

# rtc-service base URL (HTTP + Socket.IO signalling). Local dev default matches code: http://localhost:5370
# RTC_SERVICE_URL=

# Shared with rtc-service — HS256 JWT for Socket.IO auth (min 16 chars; use 32+ in prod)
RTC_JWT_SECRET=
LISTEN_HOST=

# DigitalOcean Spaces (S3-compatible) — profile photos: POST /api/profile/photos/presign
# Endpoint format: https://REGION.digitaloceanspaces.com (e.g. nyc3, sfo3, fra1)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
DO_SPACES_ENDPOINT=
# Optional: object key prefix in bucket (default profile-images)
# DO_SPACES_KEY_PREFIX=profile-images
# Optional: CDN or custom domain base URL for public object URLs
# DO_SPACES_PUBLIC_BASE_URL=

MESSAGE_ENCRYPTION_KEY=
GEMINI_API_KEY=

# Firebase Admin — same Firebase project as NEXT_PUBLIC_FIREBASE_PROJECT_ID (Console → Project settings → Service accounts → Generate key).
# Recommended: save the downloaded JSON as env/firebase-service-account.json (gitignored) and set:
FIREBASE_SERVICE_ACCOUNT_PATH=./env/firebase-service-account.json
# Alternative: entire JSON as ONE line only (multi-line in .env will fail to parse):
# FIREBASE_SERVICE_ACCOUNT_JSON=