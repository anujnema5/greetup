{
  "name": "server",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "docker compose -f ../docker-compose.dev.yml up -d && bun --watch src/index.ts",
    "debug": "bun --inspect --watch src/index.ts",
    "docker:dev": "docker compose up -d && bun --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/core/database/run-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:seed": "bun src/core/database/seed/index.ts",
    "db:seed:onboarding": "bun src/core/database/seed/seed-onboarding-lookups.ts",
    "db:seed:room-categories": "bun src/core/database/seed/seed-room-categories.ts",
    "db:seed:dev-users": "bun src/core/database/seed/seed-dev-users.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "bun src/index.ts",
    "docker:up": "docker compose up -d"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "@aws-sdk/s3-request-presigner": "^3.1026.0",
    "@google/generative-ai": "^0.24.1",
    "@socket.io/bun-engine": "^0.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "better-auth": "^1.5.6",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-seed": "^0.3.1",
    "hono": "^4.12.10",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "node-mailjet": "^6.0.11",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.2"
  }
}
