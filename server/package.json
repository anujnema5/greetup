{
  "name": "server",
  "type": "module",
  "packageManager": "bun@1.2.20",
  "scripts": {
    "dev": "docker compose -f ../docker-compose.dev.yml up -d && bun --watch src/index.ts",
    "debug": "bun --inspect --watch src/index.ts",
    "docker:dev": "docker compose up -d && bun --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:seed": "bun src/core/database/seed/index.ts",
    "db:seed:room-categories": "bun src/core/database/seed/seed-room-categories.ts",
    "db:seed:dev-users": "bun src/core/database/seed/seed-dev-users.ts",
    "build": "tsc",
    "start": "bun src/index.ts",
    "docker:up": "docker compose up -d"
  },
  "dependencies": {
    "@socket.io/bun-engine": "^0.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "better-auth": "^1.4.3",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-seed": "^0.3.1",
    "hono": "^4.10.7",
    "ioredis": "^5.8.2",
    "jose": "^6.2.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "resend": "^6.5.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3"
  }
}
