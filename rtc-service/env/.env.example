NODE_ENV=development

# HTTP / WebSocket server
RTC_HOST=0.0.0.0
RTC_PORT=5370

# mediasoup RTC port range (UDP/TCP for WebRTC media)
RTC_MIN_PORT=40000
RTC_MAX_PORT=49999

# WebRTC listen IP (0.0.0.0 to bind all interfaces)
WEBRTC_LISTEN_IP=0.0.0.0
# Announced IP — set to your public/LAN IP so clients can reach you
WEBRTC_ANNOUNCED_IP=127.0.0.1

# Redis (same store as API / matching). Docker dev often uses host port 26379.
REDIS_URL=redis://127.0.0.1:26379
REDIS_PING_TIMEOUT_MS=800
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_CONNECT_TIMEOUT_MS=10000

# Internal API key for service-to-service calls
INTERNAL_API_KEY=some_secure_internal_key

# Browser origin allowed for Socket.IO CORS (must match the web app)
WEB_CLIENT_HOST=http://localhost:3000

# Same value as main API server — JWT for Socket.IO (min 16 chars)
RTC_JWT_SECRET=
