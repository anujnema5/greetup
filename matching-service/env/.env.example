NODE_ENV=development
MATCHING_HOST=0.0.0.0
MATCHING_PORT=4020
# Docker dev (docker-compose.dev.yml): host 26379 → container 6379
REDIS_URL=redis://127.0.0.1:26379
REDIS_PING_TIMEOUT_MS=800
# Per-command timeout on request-path Redis (not BRPOP worker). 0 = disable.
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_CONNECT_TIMEOUT_MS=10000
MATCHING_ROOM_MODE=mock
ROOM_SERVICE_URL=http://localhost:3000
INTERNAL_API_KEY=some_secure_key_for_internal_api
MATCH_WEBHOOK_URL=
# Guest call trial: guest_and_registered (launch) | guest_only (strict isolation)
GUEST_MATCH_POOL=guest_and_registered